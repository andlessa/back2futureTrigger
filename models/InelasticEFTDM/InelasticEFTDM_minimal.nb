   RowBox[{"ComputeWidths", "[", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"FeynmanRules", "[", 
       RowBox[{"LBSM", ",", 
        RowBox[{"Contains", "\[Rule]", 
         RowBox[{"{", "chi2", "}"}]}], ",", 
        RowBox[{"Free", "->", 
         RowBox[{"{", "Sd", "}"}]}], ",", 
        RowBox[{"MaxParticles", "\[Rule]", "3"}]}], "]"}], "]"}], ",", 
     RowBox[{"SimplifyDecays", "\[Rule]", "True"}]}], "]"}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.964088051367343*^9, 3.964088063278298*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"aaaea6ef-0854-4395-9f40-47e9722c6ea5"]
