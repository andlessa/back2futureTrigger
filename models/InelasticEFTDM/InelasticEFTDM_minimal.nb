Cell[CellGroupData[{

Cell["Compute Decays", "Section",
 CellChangeTimes->{{3.890844988733932*^9, 3.89084500479082*^9}, {
  3.931554386698835*^9, 
  3.931554389319586*^9}},ExpressionUUID->"f03a2f44-5041-4154-810c-\
78f698b4bc23"],

Cell[BoxData[
 RowBox[{"decaysChi1", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"ComputeWidths", "[", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"FeynmanRules", "[", 
       RowBox[{"LBSM", ",", 
        RowBox[{"Contains", "\[Rule]", 
         RowBox[{"{", "chi1", "}"}]}], ",", 
        RowBox[{"Free", "->", 
         RowBox[{"{", 
          RowBox[{"Sd", ",", "chi2"}], "}"}]}], ",", 
        RowBox[{"MaxParticles", "\[Rule]", "3"}]}], "]"}], "]"}], ",", 
     RowBox[{"SimplifyDecays", "\[Rule]", "True"}]}], "]"}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.942913269637496*^9, 3.942913302357728*^9}, {
  3.942913367369527*^9, 3.942913400353602*^9}, {3.964087972531026*^9, 
  3.964087976972807*^9}, {3.9640880307806387`*^9, 3.9640880315662737`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"ea3981b2-1e09-4721-9d08-71279cfe3cb9"],

Cell[BoxData[
 RowBox[{"decaysChi2", "=", 
